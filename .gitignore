# Dependencies
node_modules/

# Build output
dist/
dist-web/
desktop-dist/
/api-types/
build-electron.out
*.tsbuildinfo

# Environment files. Only `.env.example` is a template; everything else here
# holds real values and must never be committed.
.env
.env.*
!.env.example

# Signing material
*.jks
*.keystore
keys/
android/keystore.properties
android/keystore.properties.*
!android/keystore.properties.example
android/local.properties

# Android build output
android/.gradle/
android/build/
android/app/build/
*.apk
*.aab

# Regenerated by `npx cap sync`. `assets/public` is a compiled copy of the
# web build, so a stale one embeds whatever deployment it was built against.
android/capacitor-cordova-android-plugins/
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/app/src/main/res/xml/config.xml

# Electron build resources (build/icon.ico is generated by `npm run build:icon`)
/build/

# Release artifacts
*.exe
*.blockmap
*.zip

# Local verification output
screenshots/
*.log
coverage/

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
