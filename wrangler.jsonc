{
  "$schema": "https://raw.githubusercontent.com/cloudflare/wrangler/main/.boss/schema.json",
  "name": "synqmusic",
  "main": "index.js",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "npm run build",
    "cwd": "./",
    "watch_dir": "./src"
  },
  "outputs": [{
    "directory": "./dist",
    "bundle": false
  }]
}
