# ---------------------------------------------------------------------------
# Release signing for SYNQ. Copy this file to `android/keystore.properties` and
# fill in your own values. The real file is gitignored and must stay that way —
# it contains passwords, and the keystore it points at is the identity of the
# app on Google Play.
#
#   cp android/keystore.properties.example android/keystore.properties
#
# Creating a keystore (one time, and then never again for this app ID):
#
#   keytool -genkeypair -v \
#     -keystore android/synq-release.jks \
#     -storetype PKCS12 \
#     -alias synq \
#     -keyalg RSA -keysize 4096 -validity 10000 \
#     -dname "CN=SYNQ, O=SYNQ, C=US"
#
# `npm run android:keystore` runs the same thing with a generated password and
# writes this properties file for you.
#
# BACK BOTH FILES UP somewhere outside this working copy: the keystore, and the
# passwords to it. If this key is lost you can never ship an update to the same
# app listing again (Play App Signing can recover you only if you enrolled your
# upload key in it and still hold a valid one).
# ---------------------------------------------------------------------------

# Path to the keystore. Relative paths are resolved from the `android/`
# directory; absolute paths also work.
storeFile=synq-release.jks

# The password for the keystore (the "store" password).
storePassword=change-me

# The alias of the key inside the keystore.
keyAlias=synq

# The password for that key. With a PKCS12 keystore — what modern keytool
# produces — this is the same as storePassword, and keytool will refuse a
# different one. It is kept as a separate line because JKS keystores can use a
# different key password, and because Android's own tooling expects the field.
keyPassword=change-me
