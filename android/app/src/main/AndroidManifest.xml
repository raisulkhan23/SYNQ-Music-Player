<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Background playback.

         Music that keeps playing with the screen off is a foreground service on
         Android, and since Android 17 it is mandatory: the audio framework
         refuses background audio (silently, with no exception) unless the app
         has a visible activity or a non-SHORT foreground service, "whether or
         not the app targets API level 37". These four permissions exist for
         exactly that one service:

           FOREGROUND_SERVICE            — run any foreground service at all.
           FOREGROUND_SERVICE_MEDIA_PLAYBACK — the service is of type
                                             mediaPlayback. Required from
                                             Android 14 (API 34); starting the
                                             service without it throws
                                             SecurityException.
           WAKE_LOCK                      — lets the media playback hold the CPU
                                             awake while the display is off, so
                                             a long track cannot be cut short by
                                             the device falling idle.
           POST_NOTIFICATIONS             — for the media notification. Media
                                             session notifications are exempt
                                             from this runtime permission, so the
                                             card is not gated on it; it is
                                             declared so the foreground service's
                                             notification channel is fully
                                             visible, and is never requested at
                                             runtime because nothing here needs
                                             an unrelated notification.

         The service and the MEDIA_BUTTON receiver themselves are contributed by
         the @capgo/capacitor-media-session plugin's own manifest, and merge into
         the release manifest from there. Nothing here asks for a permission the
         background player does not use. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
