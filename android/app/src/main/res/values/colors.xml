<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      SYNQ's system-bar palette.

      WHY THIS FILE EXISTS. `styles.xml` asks for `@color/colorPrimary`,
      `@color/colorPrimaryDark` and `@color/colorAccent`. None of them were
      defined in this module, so the build silently resolved them to the
      Material Design defaults shipped inside the AppCompat AAR:

          colorPrimary     #3F51B5  (Indigo 500)
          colorPrimaryDark #303F9F  (Indigo 700)
          colorAccent      #FF4081  (Pink A200)

      The visible result was a bright INDIGO status bar sitting on top of a
      dark violet app — the single most obvious "this is a template project"
      tell on the home screen and in recents. `colorAccent` additionally
      drove any AppCompat widget that inherits it (checkboxes, sliders,
      ripple highlights) pink, which is not a SYNQ colour.

      These are now SYNQ's own values, taken from the same tokens the web
      build uses: the theme-color in index.html, and the brand tint (also
      written as c42ad6) used by the mask-icon and the CSS tint variable.
    -->
    <color name="colorPrimary">#12141C</color>
    <color name="colorPrimaryDark">#0B0C12</color>
    <color name="colorAccent">#C42AD6</color>

    <!-- The surface behind the WebView before the first frame paints. -->
    <color name="synq_background">#12141C</color>
</resources>
