<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      SYNQ's base theme. Kept as the parent of the two variants below because
      the manifest names `@style/AppTheme` on <application>.

      WHY NOT DayNight. Both variants used to inherit from
      `Theme.AppCompat.DayNight.*`. SYNQ is dark-only — `main.tsx` puts `dark`
      on <html> unconditionally and only removes it for the explicit Light
      setting — so a DayNight host theme bought nothing and cost two things:
      on a phone in light mode the window background is WHITE, which flashed
      white on every cold start behind the WebView, and the system-bar icon
      contrast was computed for a light surface, so the status bar clock and
      the nav-bar gesture pill could go dark-on-dark over a dark app. Pinning
      the dark theme matches what the renderer always draws.
    -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!-- SYNQ's own surface, so the first frame is the app's background
             and not white. -->
        <item name="android:windowBackground">@color/synq_background</item>
        <!-- The surface is always dark, so the bars always carry light
             icons. Without this a light-mode phone could render the clock
             dark-on-dark. -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- targetSdk 36 enforces edge-to-edge: the WebView draws behind the
             system bars and the CSS reads `env(safe-area-inset-*)` for the
             top bar, the bottom nav and the player. Transparent bars keep
             that contract and stop the OS painting an opaque strip in a
             colour that does not match the app surface. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!--
      Cold-start theme. `Theme.SplashScreen` is the Android 12+ splash API
      (androidx core-splashscreen); on older devices only the window
      background is visible. Both are pinned to SYNQ's dark surface so the
      very first frame is the app's own background rather than white.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@color/synq_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>