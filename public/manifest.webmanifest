{
  "id": "/",
  "name": "SYNQ — Music, uninterrupted",
  "short_name": "SYNQ",
  "description": "Music-only discovery, a queue that moves like you do, and a live visualizer. No ads, no noise.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#12141c",
  "theme_color": "#12141c",
  "dir": "ltr",
  "lang": "en",
  "categories": ["music", "entertainment", "lifestyle"],
  "icons": [
