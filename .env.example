# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# Server-only: set these on the Convex deployment, never in a client build.
# Jamendo's official API is required for Jamendo downloads.
# npx convex env set JAMENDO_CLIENT_ID your-key
#
# SoundCloud downloads use the official OAuth 2.1 client-credentials API.
# A registered SoundCloud app and an Artist Pro plan are required. Without
# both values the server refuses SoundCloud downloads instead of using the
# public website client id that playback search uses.
# npx convex env set SOUNDCLOUD_CLIENT_ID your-client-id
# npx convex env set SOUNDCLOUD_CLIENT_SECRET your-client-secret
