# SYNQ environment template.
#
# Copy to `.env.local` (never commit it) and fill in your own values.
#
# Two groups of variables:
#   1. Frontend (VITE_*) — compiled into the browser bundle, so they are public
#      by definition. Never put a secret in one.
#   2. Backend — set on your Convex deployment with
#        npx convex env set NAME value
#      They stay on the server and are never sent to a client.

# ─── Frontend (Vite) ────────────────────────────────────────────────────────

# Your Convex deployment URL, from `npx convex dev`.
# Convex serves the client API at `.convex.cloud` and HTTP actions at
# `.convex.site`; SYNQ derives the second from this value.
# Without it the app still boots, but sign-in, library, playlists and history
# are unavailable (it says so in the console).
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Optional: Spotify Web API client id used by the "Import from Spotify" flow.
# The matching secret stays on the backend (SPOTIFY_CLIENT_SECRET below).
VITE_SPOTIFY_CLIENT_ID=

# Deployment used by `npx convex dev`. Filled in for you by the CLI.
CONVEX_DEPLOYMENT=

# Base URL for OAuth redirects back into the app during local development.
CONVEX_SITE_URL=http://localhost:5173

# ─── Backend (Convex environment) ───────────────────────────────────────────

# Convex Auth. `SITE_URL` is the deployment's own origin; the JWT pair is the
# key material Convex Auth issues sessions with:
#   npx @convex-dev/auth   # generates JWT_PRIVATE_KEY and JWKS for you
SITE_URL=
JWT_PRIVATE_KEY=
JWKS=

# Optional OAuth sign-in providers. Without them the email-code and guest
# sign-in paths still work.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Jamendo — Creative Commons catalogue and the only provider SYNQ is licensed
# to download from. Free key: https://devportal.jamendo.com
JAMENDO_CLIENT_ID=

# Spotify metadata/import. Needs both halves of the same app.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# TIDAL metadata.
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=

# Apple Music catalogue (MusicKit developer token). The private key is a
# multi-line .p8 file's contents; paste it with real newlines.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=

# Optional lyrics providers. Without a key SYNQ falls back to the free
# LRCLIB lookup for synced lyrics.
MUSIXMATCH_API_KEY=

# Optional playback reliability: a YouTube cookie lets the backend resolver
# answer from a signed-in session instead of being bot-checked.
YOUTUBE_COOKIE=

# Optional advertising: Gravity serves ads through the backend so the key never
# reaches the browser. With no key the ad slot renders nothing.
GRAVITY_API_KEY=
GRAVITY_PRODUCTION=false

# Optional analytics / monitoring.
AMPLITUDE_API_KEY=
VITE_VLY_APP_ID=
VITE_VLY_MONITORING_URL=
